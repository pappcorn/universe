{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "module": "commonjs",
    "moduleResolution": "node",
    "customConditions": null,
    "composite": false,
    "declaration": true,
    "emitDeclarationOnly": false,
    "noEmitOnError": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["dist"]
}
