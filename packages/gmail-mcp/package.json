{
  "name": "@pappcorn/gmail-mcp",
  "version": "0.2.0",
  "description": "MCP server for Gmail — read, search, triage, draft and send from your own account, using your own Google OAuth app.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/pappcorn/universe.git",
    "directory": "packages/gmail-mcp"
  },
  "homepage": "https://github.com/pappcorn/universe/tree/main/packages/gmail-mcp",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "gmail",
    "email",
    "claude"
  ],
  "type": "commonjs",
  "main": "./dist/mcp.js",
  "bin": {
    "gmail-mcp": "./dist/mcp.js",
    "pappcorn-gmail-mcp": "./dist/mcp.js",
    "pappcorn-gmail": "./dist/cli.js",
    "pappcorn-gmail-setup": "./scripts/mint-token.mjs"
  },
  "files": [
    "dist",
    "bin",
    "scripts",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.lib.json && npm run bundle",
    "bundle": "esbuild src/mcp.ts --bundle --platform=node --format=cjs --target=node20 --outfile=bin/mcp.cjs",
    "gmail": "node -r @swc-node/register src/cli.ts",
    "mint-token": "node scripts/mint-token.mjs",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^3.25.76"
  },
  "engines": {
    "node": ">=20"
  }
}
