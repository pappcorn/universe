{
  "name": "@pappcorn/whatsapp-mcp",
  "version": "0.2.1",
  "description": "MCP server for WhatsApp — send messages and approved templates from your own number via Meta's official WhatsApp Cloud API.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/pappcorn/universe.git",
    "directory": "packages/whatsapp-mcp"
  },
  "homepage": "https://github.com/pappcorn/universe/tree/main/packages/whatsapp-mcp",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "whatsapp",
    "cloud-api",
    "claude"
  ],
  "type": "commonjs",
  "main": "./dist/mcp.js",
  "bin": {
    "whatsapp-mcp": "./dist/mcp.js",
    "pappcorn-whatsapp-mcp": "./dist/mcp.js",
    "pappcorn-whatsapp": "./dist/cli.js"
  },
  "files": [
    "dist",
    "server",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.lib.json && npm run bundle",
    "bundle": "esbuild src/mcp.ts --bundle --platform=node --format=cjs --target=node20 --outfile=server/mcp.cjs",
    "whatsapp": "node -r @swc-node/register src/cli.ts",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.4.3"
  },
  "engines": {
    "node": ">=20"
  }
}
