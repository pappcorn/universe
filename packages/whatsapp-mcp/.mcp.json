{
  "mcpServers": {
    "whatsapp": {
      "command": "node",
      "args": ["${CLAUDE_PLUGIN_ROOT}/server/mcp.cjs"],
      "env": {
        "WHATSAPP_ACCESS_TOKEN": "${user_config.access_token}",
        "WHATSAPP_PHONE_NUMBER_ID": "${user_config.phone_number_id}",
        "WHATSAPP_WABA_ID": "${user_config.waba_id}"
      }
    }
  }
}
